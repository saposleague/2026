{
  "name": "sapos-league-functions",
  "description": "Cloud Functions para Sapos League - Notificações Automáticas",
  "version": "1.0.0",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "check": "node --check index.js && node -e \"require('./index.js')\"",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0",
    "web-push": "^3.6.7"
  },
  "private": true
}
