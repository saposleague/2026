# ──────────────────────────────────────────────────────────────────────────────
# VARIÁVEIS DE AMBIENTE — Firebase Functions (sistema params, v2+)
# ──────────────────────────────────────────────────────────────────────────────
#
# Como usar:
#   1. Copie este arquivo para functions/.env
#      cp functions/.env.example functions/.env
#
#   2. Preencha os valores reais em functions/.env
#      O arquivo .env já está no .gitignore — nunca será commitado.
#
#   3. O Firebase lê automaticamente functions/.env no deploy e no emulator.
#
# Documentação oficial:
#   https://firebase.google.com/docs/functions/config-env
# ──────────────────────────────────────────────────────────────────────────────

# Chave PÚBLICA VAPID (pode ficar no código — está em sw.js e web-push-ios.js)
VAPID_PUBLIC_KEY=BOD3066MNR-gYBI6qquZcm2RxlN_ia_dQtADtGZGhan7SeuxcN6T8WwWB0sEnMpWpQ0aS0OkwoItlgYza1MkiRg

# Chave PRIVADA VAPID — nunca expor no código-fonte
VAPID_PRIVATE_KEY=<sua_chave_privada_aqui>

# Email de contato para identificação VAPID
VAPID_MAILTO=mailto:contato@saposleague.com

# URL do projeto Supabase (não é segredo)
SUPABASE_PROJECT_URL=https://yaapgjkvkhsfsskkbmso.supabase.co

# UIDs Firebase autorizados como administradores, separados por vírgula.
# O primeiro acesso válido atribui automaticamente a custom claim admin=true.
ADMIN_FIREBASE_UIDS=HClXNJyivTWibYcrirCYxhM96Ze2

# A chave elevada do Supabase NÃO deve ser colocada neste arquivo.
# Use preferencialmente uma chave Secret (sb_secret_...) ou, durante a
# transição, a service_role legada. Cadastre-a pelo Firebase CLI:
#   firebase functions:secrets:set SUPABASE_ADMIN_KEY
